<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SamorodinkaTech.GravityDiagram.Demo"
        x:Class="SamorodinkaTech.GravityDiagram.Demo.MainWindow"
        Title="Gravity Diagram Demo"
        Width="1200" Height="700">

    <ThemeVariantScope>
        <Grid ColumnDefinitions="280,*">
            <Border Grid.Column="0" Background="#F5F5F5" Padding="8">
                <ScrollViewer>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Gravity Diagram" FontWeight="Bold" FontSize="16" />

                        <ComboBox x:Name="ModelSelector" SelectedIndex="0">
                            <ComboBoxItem Content="2 ноды (A → B)" />
                            <ComboBoxItem Content="3 ноды (1 → 2, 1 → 3)" />
                        </ComboBox>

                        <Button x:Name="DumpButton" Content="Сохранить дамп шага (JSON)" />
                        <TextBlock x:Name="DumpStatus" Text="" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                        <Separator />

                        <TextBlock Text="Фоновое притяжение" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="GravitySlider" Minimum="0" Maximum="1" Width="220" />
                            <TextBlock x:Name="GravityValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Масса ноды" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="NodeMassSlider" Minimum="1" Maximum="100" Width="220" />
                            <TextBlock x:Name="NodeMassValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Притяжение по дугам" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="ConnectedAttractionSlider" Minimum="0" Maximum="20" Width="220" />
                            <TextBlock x:Name="ConnectedAttractionValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Длина покоя дуги" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="RestLenSlider" Minimum="0" Maximum="600" Width="220" />
                            <TextBlock x:Name="RestLenValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Отталкивание от перекрытий" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="RepulsionSlider" Minimum="0" Maximum="200" Width="220" />
                            <TextBlock x:Name="RepulsionValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Буст при отключённом жёстком разведении" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="SoftOverlapBoostSlider" Minimum="0" Maximum="10" Width="220" />
                            <TextBlock x:Name="SoftOverlapBoostValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Порог нормализации сил" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="ForceNormThresholdSlider" Minimum="0" Maximum="10" Width="220" />
                            <TextBlock x:Name="ForceNormThresholdValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <Separator />

                        <CheckBox x:Name="MinimizeArcCheck" Content="Дуги минимизируют длину (физика)" />
                        <CheckBox x:Name="FixFirstPointToNormalCheck" Content="Фиксировать первую точку дуги по нормали" />
                        <CheckBox x:Name="FixLastPointToNormalCheck" Content="Фиксировать последнюю точку дуги по нормали" />

                        <TextBlock Text="Итерации жёсткого разведения" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="HardIterSlider" Minimum="0" Maximum="20" Width="220" />
                            <TextBlock x:Name="HardIterValue" Width="70" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button x:Name="StabilizeButton" Content="Стабилизировать" />
                        <TextBlock Text="Подсказка: если всё дрожит — нажми Стабилизировать." Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <local:DiagramView Grid.Column="1" x:Name="DiagramView" />
        </Grid>
    </ThemeVariantScope>
</Window>
